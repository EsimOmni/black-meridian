# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Build outputs
/build/
*.exe
*.pck
*.zip

# Heavy regeneratable assets (splats, hi-res meshes regenerate from Marble)
assets/splat/**/*.ply
assets/splat/**/*.spz
assets/splat/**/*.glb

# godot-ai MCP editor plugin — third-party tool, self-updates on launch (churns
# ~220 files every version bump). Not game code; keep it out of the tree. The
# working copy stays on disk; reinstall the plugin on a fresh clone. (gdgs is
# NOT ignored — the splat plugin carries our Godot-4.7 push-constant patch.)
addons/godot_ai/

# Godot editor/runtime user data — logs, keystores, editor settings, boot-smoke
# output. Regenerated every run; never game code. (.godot/ above is the import
# cache; .godot_user/ is the separate user-data dir.)
.godot_user/

# Asset-production iteration screenshots (Codex/Blender massing + placement refs).
# Working refs, not shipped assets — keep them local.
screenshots/

# Gemini operator bridge (claude-bridge skill + queue). Operator tooling, not the
# game; each agent maintains its own copy.
.agents/

# OS / editor cruft
.DS_Store
Thumbs.db
*.tmp

# Concept-runner tooling (image/video generation via Magnific + Google Flow web
# UI, Playwright-driven). Browser profiles hold login cookies/secrets — NEVER
# commit. Outputs are regeneratable renders, not source. venv is a local build.
tools/concept-runners/.venv/
tools/concept-runners/**/__pycache__/
tools/concept-runners/**/*.pyc
tools/concept-runners/magnific/magnific-profile/
tools/concept-runners/magnific/outputs/
tools/concept-runners/google-flow/flow-profile/
tools/concept-runners/google-flow/outputs/

# Playwright MCP scratch (screenshots, logs, snapshots)
.playwright-mcp/

# Python bytecode cache
__pycache__/
*.pyc

# 3D pipeline generated artifacts (immutable raw outputs — regenerated per job, not source)
assets/_generated/*/
assets/_exports/*/
jobs/reports/*/

# Repo-root scratch + throwaway probe files (ad-hoc dumps from tooling/debugging —
# never source). Keep the tree clean of one-off txt dumps and test scripts.
/api_output.txt
/scratch_output.txt
/test_api.py
/scratchpad/
assets/city/**/mesh_uvs.txt

# Third-party engine/DCC exports staged locally (UE/MetaHuman character exports,
# plugin drops). Large, regeneratable, not this game's source.
/Exports/
/Plugins/

# MetaHuman / character-factory audit notes — local pipeline scratch, not game source.
/docs/CharacterFactory/

# Pipeline staging references (concept views, cutouts fed to Hunyuan/Blender).
# A .gdignore keeps Godot from importing them; keep the images local only.
assets/_references/**/*.png
assets/_references/**/*.jpg
