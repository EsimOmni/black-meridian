# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Build outputs
/build/
*.exe
*.pck
*.zip

# Heavy regeneratable assets (splats, hi-res meshes regenerate from Marble)
assets/splat/**/*.ply
assets/splat/**/*.spz
assets/splat/**/*.glb

# OS / editor cruft
.DS_Store
Thumbs.db
*.tmp
