# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Build outputs
/build/
*.exe
*.pck
*.zip

# Heavy regeneratable assets (splats, hi-res meshes regenerate from Marble)
assets/splat/**/*.ply
assets/splat/**/*.spz
assets/splat/**/*.glb

# godot-ai MCP editor plugin — third-party tool, self-updates on launch (churns
# ~220 files every version bump). Not game code; keep it out of the tree. The
# working copy stays on disk; reinstall the plugin on a fresh clone. (gdgs is
# NOT ignored — the splat plugin carries our Godot-4.7 push-constant patch.)
addons/godot_ai/

# OS / editor cruft
.DS_Store
Thumbs.db
*.tmp
